# Confluence Data Center: copy to .env.company and select with --env .env.company.
# Bearer authentication uses a PAT issued by this Confluence server.
CONFLUENCE_DEPLOYMENT=datacenter
CONFLUENCE_AUTH=bearer
CONFLUENCE_SITE_URL=https://wiki.company.example/confluence
CONFLUENCE_API_URL=https://wiki.company.example/confluence/rest/api
CONFLUENCE_PAT=
CONFLUENCE_SPACE_KEY=DOCS

# Keep the server's actual context path, such as /confluence, in both URLs.
# Do not add Cloud email, cloud ID, or API token settings to this PAT profile.
# Trust a corporate CA via NODE_EXTRA_CA_CERTS in the process environment.

# Optional installed Data Center macros: verify their real names and source fields.
# CONFLUENCE_MERMAID_MACRO=mermaid
# CONFLUENCE_PLANTUML_MACRO=plantuml
# CONFLUENCE_PLANTUML_SOURCE_PARAMETER=source
# CONFLUENCE_PLANTUML_PARAMETERS={"theme":"plain"}

# Optional local validator executables:
# CFWIKI_CHROME_PATH=/path/to/chrome
# CFWIKI_PLANTUML_PATH=/path/to/plantuml

# Cloud profile: copy to ~/.config/cfwiki/.env, or select a file with --env.
# Explicit profiles: .env.cloud.example or .env.company.example.
CONFLUENCE_DEPLOYMENT=cloud
CONFLUENCE_AUTH=basic
CONFLUENCE_SITE_URL=https://your-test-site.atlassian.net
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_CLOUD_ID=
CONFLUENCE_SPACE_KEY=AGENTTEST
CONFLUENCE_API_TOKEN=
# Set a native template ID from `cfwiki templates list`, or override with --template ID.
CONFLUENCE_TEMPLATE=none
CONFLUENCE_PRESERVE=minimal
# CONFLUENCE_TEMPLATE=123456
# Relative template paths are resolved beside this profile, not the working directory.
# CONFLUENCE_TEMPLATE=./wiki-template.yaml
# CONFLUENCE_DIAGRAM_MODE=macro
# Optional explicit full API bases; see README for a corporate bearer PAT profile.
# CONFLUENCE_API_URL=https://your-test-site.atlassian.net/wiki/api/v2
# CONFLUENCE_API_V1_URL=https://your-test-site.atlassian.net/wiki/rest/api

# Set exact storage macro names from apps installed on your Confluence instance.
# CONFLUENCE_MERMAID_MACRO=mermaid
# CONFLUENCE_PLANTUML_MACRO=plantuml
# For apps that store source in an ac:parameter instead of ac:plain-text-body:
# CONFLUENCE_PLANTUML_SOURCE_PARAMETER=source
# Optional app-specific static parameters (JSON string values):
# CONFLUENCE_MERMAID_PARAMETERS={"theme":"default"}
# Forge apps: copy the full extension-key from a page created by the installed app.
# CONFLUENCE_MERMAID_ADAPTER=mermaid-viewer
# CONFLUENCE_MERMAID_FORGE_EXTENSION_KEY=<app-id>/<environment-id>/static/mermaid-diagram
# CONFLUENCE_MERMAID_TITLE=Mermaid diagram
# CONFLUENCE_PLANTUML_ADAPTER=forge
# CONFLUENCE_PLANTUML_FORGE_EXTENSION_KEY=<app-id>/<environment-id>/static/plantuml-confluence
# For Narva PlantUML, use MACRO=plantuml-confluence and SOURCE_PARAMETER=diagram-code.
# CONFLUENCE_PLANTUML_TITLE=PlantUML Diagrams
# Optional local validator executables:
# CFWIKI_CHROME_PATH=/path/to/chrome
# CFWIKI_PLANTUML_PATH=/path/to/plantuml
